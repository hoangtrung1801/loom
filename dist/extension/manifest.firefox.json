{
	"manifest_version": 3,
	"name": "Loom Web Clipper",
	"description": "Save web content to Loom — open, encrypted, and local-first application that connects everything as objects.",
	"version": "0.0.8",
	"icons": {
		"16": "img/icon16x16.png",
		"128": "img/icon128x128.png"
	},
	"options_page": "settings/index.html",
	"action": {
		"default_title": "Loom Web Clipper",
		"default_popup": "popup/index.html"
	},
	"permissions": [
		"contextMenus",
		"nativeMessaging",
		"tabs",
		"activeTab"
	],
	"background": {
		"scripts": ["js/background.js"]
	},
	"content_scripts": [
		{
			"js": [ "js/foreground.js" ],
			"css": [ "css/foreground.css" ],
			"matches": [ "<all_urls>" ]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [ "iframe/index.html" ],
			"matches": [ "<all_urls>" ]
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "anytype@anytype.io",
			"strict_min_version": "109.0"
		}
	}
}
