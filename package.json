{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "description": "Loom: a local-first visual note-taking app (cards on whiteboards)",
  "main": "dist/electron/main.cjs",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:electron": "bun scripts/ensure-electron.mjs && bun scripts/dev-electron.ts",
    "build": "bunx --bun vite build && bun scripts/build-main.mjs",
    "start": "bun run build && bun scripts/ensure-electron.mjs && electron .",
    "sync-server": "bun server/main.ts",
    "typecheck": "tsc -p .",
    "test": "bunx --bun vitest run",
    "test:e2e": "bunx --bun vitest run -c vitest.e2e.config.ts",
    "test:electron": "bun run build && bun scripts/ensure-electron.mjs && xvfb-run -a bunx --bun vitest run -c vitest.electron.config.ts",
    "package": "bun run build && electron-builder"
  },
  "author": "Loom contributors",
  "build": {
    "appId": "dev.loom.app",
    "productName": "Loom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**",
      "dist/renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
