{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "description": "Loom: a local-first visual note-taking app (cards on whiteboards)",
  "main": "dist/electron/main.cjs",
  "bin": {
    "loom": "dist/cli/loom.cjs"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:electron": "bun scripts/ensure-electron.mjs && bun scripts/dev-electron.ts",
    "build": "bunx --bun vite build && bun scripts/build-main.mjs",
    "start": "bun run build && bun scripts/ensure-electron.mjs && electron .",
    "sync-server": "bun server/main.ts",
    "loom": "bun src/cli/loom.ts",
    "typecheck": "tsc -p .",
    "test": "bunx --bun vitest run",
    "test:e2e": "bunx --bun vitest run -c vitest.e2e.config.ts",
    "test:electron": "bun run build && bun scripts/ensure-electron.mjs && xvfb-run -a bunx --bun vitest run -c vitest.electron.config.ts",
    "package": "bun run build && electron-builder",
    "icons": "node scripts/make-icons.mjs"
  },
  "author": {
    "name": "Loom contributors",
    "email": "hoangtrung1801.2003@gmail.com"
  },
  "desktopName": "loom.desktop",
  "build": {
    "appId": "dev.loom.app",
    "productName": "Loom",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/electron/**",
      "dist/cli/**",
      "dist/renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/electron/core-worker.cjs"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
